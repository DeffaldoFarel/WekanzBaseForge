# ==============================================================================
# BaseForge Server Environment Variables
# ==============================================================================

# Port backend server (default: 5100)
PORT=5100

# Kredensial Login Admin Dashboard (default development)
ADMIN_EMAIL=admin@baseforge.local
ADMIN_PASSWORD=admin123

# Secret Key untuk Enkripsi JWT Access Token End-User
# (Opsional di development, WAJIB diubah di production)
# JWT_SECRET=ganti-dengan-string-rahasia-panjang-dan-acak-di-production

# Redis URL untuk Persistent Rate Limiting (Opsional)
# Kosongkan untuk menggunakan in-memory fallback otomatis (tanpa Redis)
# REDIS_URL=redis://127.0.0.1:6379

# Folder Penyimpanan Data (platform.db, per-project databases & files)
# Default: ../data (relatif terhadap direktori server)
# DATA_DIR=../data
