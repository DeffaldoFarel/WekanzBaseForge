# ==============================================================================
# BaseForge Server Environment Variables
# ==============================================================================

# Port backend server (default: 5100)
PORT=5100

# Akun Master Administrator Platform:
# Dibuat saat pertama kali membuka Dashboard di browser via halaman setup (/signup).
# Kredensial tersimpan secara aman di database (platform.db) dengan hashing scrypt OWASP.
# Tidak ada kredensial admin default plaintext dari environment variable.
# (ADMIN_EMAIL & ADMIN_PASSWORD hanya dipakai otomatis oleh test suite 'npm test').

# Secret Key untuk Enkripsi JWT Access Token End-User
# (Opsional di development, WAJIB diubah di production)
# JWT_SECRET=ganti-dengan-string-rahasia-panjang-dan-acak-di-production

# Secret Key untuk Enkripsi Client Secret OAuth2 (M10: Google/GitHub Login)
# Client secret provider di-encrypt AES-256-GCM dengan key turunan ini.
# Kosongkan → fallback ke JWT_SECRET. WAJIB diisi di production.
# OAUTH_SECRET=ganti-dengan-string-rahasia-lain-panjang-dan-acak-di-production

# Redis URL untuk Persistent Rate Limiting (Opsional)
# Kosongkan untuk menggunakan in-memory fallback otomatis (tanpa Redis)
# REDIS_URL=redis://127.0.0.1:6379

# ─── M23: SMTP Mail Service (Email Verifikasi & Reset Password) ─────────────
# Tanpa SMTP_HOST yang aktif, email masuk ke DEV OUTBOX (tabel _platform_settings
# + konsol) — link verifikasi tetap bisa diambil via dashboard Settings > Outbox.
# Konfigurasi juga bisa diatur runtime lewat Admin API (mengalahkan env).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=app-password-dari-google
# SMTP_SECURE=false          # true = TLS langsung (port 465), false = STARTTLS (587)
# MAIL_FROM=BaseForge <no-reply@baseforge.local>

# ─── M30: S3-Compatible Storage Backend (opsional) ──────────────────────────
# Tanpa S3_ENDPOINT, storage menggunakan LOCAL DISK (data/storage/).
# Konfigurasi juga bisa diatur runtime lewat Admin API (mengalahkan env).
# Kompatibel: AWS S3, Cloudflare R2, MinIO, DO Spaces, Backblaze B2
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_REGION=us-east-1
# S3_BUCKET=my-bucket
# S3_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# S3_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# S3_PREFIX=baseforge        # optional: subdirectory dalam bucket

# Folder Penyimpanan Data (platform.db, per-project databases & files)
# Default: ../data (relatif terhadap direktori server)
# DATA_DIR=../data
