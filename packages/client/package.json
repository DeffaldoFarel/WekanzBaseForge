{
  "name": "@wekanz/baseforge",
  "version": "0.3.0",
  "description": "Official lightweight TypeScript/JavaScript SDK for WekanzBaseForge BaaS platform",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
